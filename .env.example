# SQLite database file location
DATABASE_URL=file:./db/custom.db

# Background-removal model (downloaded/verified by scripts/seed.ts)
SYNKRA_BG_MODEL_FILE=media/models/u2netp.onnx
SYNKRA_BG_MODEL_BYTES=4574861
SYNKRA_BG_MODEL_SHA256=309c8469258dda742793dce0ebea8e6dd393174f89934733ecc8b14c76f4ddd8

# Realtime collaboration
SYNKRA_REALTIME_ENABLED=true
NEXT_PUBLIC_REALTIME_PORT=3010

# Shared token between the Next.js app and the realtime mini-service (dev default; change in production)
SYNKRA_SERVICE_TOKEN=change-me

# Cookie security mode for deployments behind TLS-terminating proxies that forward plain HTTP
# internally (e.g. embedded sandbox previews): auto (default) | always | never
SYNKRA_COOKIE_SECURE=auto

# HMAC secret for signed CSRF tokens served to cookie-blocked clients (defaults to the service token)
# SYNKRA_CSRF_SECRET=change-me-too
